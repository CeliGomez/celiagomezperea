---
import Formulario from './Formulario.jsx'

/*
	Página Contacto.
	1. Banda de foto: la foto del taller de borde a borde, con el título encima del lado oscuro.
	2. Debajo, en dos columnas: a la izquierda los contactos directos y «Para qué escribir»;
	   a la derecha el formulario en una tarjeta blanca que se sube sobre la foto.
	   En celular: el formulario primero y después los contactos.
*/
const {
	foto = null,
	email = '',
	instagram = '',
	vimeo = '',
	ciudad = '',
	whatsapp = '',
	clave = '',
	prioridadFoto = false,
} = Astro.props

function textoInstagram(url) {
	try {
		const partes = new URL(url).pathname.split('/').filter(Boolean)
		return partes[0] ? `@${partes[0]}` : url
	} catch {
		return url
	}
}

function textoSitio(url) {
	try {
		const destino = new URL(url)
		const camino = destino.pathname.replace(/\/$/, '')
		return `${destino.hostname.replace(/^www\./, '')}${camino}`
	} catch {
		return url
	}
}

function linkWhatsapp(numero) {
	const digitos = String(numero || '').replace(/\D/g, '')
	return digitos ? `https://wa.me/${digitos}` : ''
}

const filas = [
	email && { id: 'email', etiqueta: 'Email', valor: email, href: `mailto:${email}` },
	whatsapp && linkWhatsapp(whatsapp) && {
		id: 'whatsapp',
		etiqueta: 'WhatsApp',
		valor: whatsapp,
		href: linkWhatsapp(whatsapp),
		externo: true,
	},
	instagram && {
		id: 'instagram',
		etiqueta: 'Instagram',
		valor: textoInstagram(instagram),
		href: instagram,
		externo: true,
	},
	vimeo && { id: 'vimeo', etiqueta: 'Vimeo', valor: textoSitio(vimeo), href: vimeo, externo: true },
	ciudad && { id: 'ciudad', etiqueta: 'Taller', valor: ciudad },
].filter(Boolean)

const motivos = [
	{ titulo: 'Adquisición de obra', texto: 'Consultas por cuadros e ilustraciones disponibles.' },
	{ titulo: 'Exposiciones y curaduría', texto: 'Muestras, salones, residencias y proyectos curatoriales.' },
	{ titulo: 'Talleres', texto: 'Actividades de la Estación Nómade y talleres de arte y cuerpo.' },
	{ titulo: 'Charlas y docencia', texto: 'Encuentros sobre arte, territorio y cuerpo.' },
]
---

<div class="pc">
	{/* ——— 1. Banda de foto ——— */}
	<header class:list={['pc-banda', !foto && 'pc-banda--sin-foto']}>
		{
			foto && (
				<img
					class="pc-banda__foto"
					src={foto.src}
					srcset={foto.srcset}
					sizes="100vw"
					alt={foto.alt || ''}
					width={foto.ancho}
					height={foto.alto}
					loading={prioridadFoto ? 'eager' : 'lazy'}
					fetchpriority={prioridadFoto ? 'high' : 'auto'}
					decoding="async"
				/>
			)
		}
		<div class="pc-banda__texto contenedor">
			<p class="pc-etiqueta pc-etiqueta--dorada">Contacto</p>
			<h1 class="pc-banda__titulo">Hablemos</h1>
			<span class="filete filete--largo" aria-hidden="true"></span>
			<p class="pc-banda__bajada">
				Estoy abierta a colaboraciones, proyectos curatoriales, exposiciones y adquisiciones de obra.
			</p>
		</div>
	</header>

	{/* ——— 2. Contactos y formulario ——— */}
	<section class="pc-cuerpo" aria-label="Escribir a Celia">
		<div class="pc-cuerpo__grilla contenedor">
			<div class="pc-form">
				<p class="pc-etiqueta">Escribime</p>
				<h2 class="pc-form__titulo">Dejame tu mensaje</h2>
				<p class="pc-form__nota">Respondo por email, en general dentro de la semana.</p>
				<Formulario client:load clave={clave} whatsapp={whatsapp} email={email} instagram={instagram} vimeo={vimeo} />
			</div>

			<div class="pc-info">
				{
					filas.length > 0 && (
						<div class="pc-bloque">
							<p class="pc-etiqueta">Contacto directo</p>
							<ul class="pc-directo">
								{filas.map((fila) => (
									<li>
										<span class="pc-directo__etiqueta">{fila.etiqueta}</span>
										{fila.href ? (
											<a
												href={fila.href}
												target={fila.externo ? '_blank' : undefined}
												rel={fila.externo ? 'noopener noreferrer' : undefined}
											>
												{fila.valor}
											</a>
										) : (
											<span class="pc-directo__valor">{fila.valor}</span>
										)}
									</li>
								))}
							</ul>
						</div>
					)
				}

				<div class="pc-bloque">
					<p class="pc-etiqueta">Para qué escribir</p>
					<ul class="pc-motivos">
						{motivos.map((motivo, indice) => (
							<li>
								<span class="pc-motivos__numero">{String(indice + 1).padStart(2, '0')}</span>
								<span>
									<span class="pc-motivos__titulo">{motivo.titulo}</span>
									<span class="pc-motivos__texto">{motivo.texto}</span>
								</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
</div>

<style>
	/* ——— Comunes ——— */
	.pc-etiqueta {
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--dorado-oscuro);
	}

	.pc-etiqueta--dorada {
		color: var(--dorado);
	}

	/* ——— 1. Banda de foto ——— */
	.pc-banda {
		position: relative;
		display: grid;
		align-items: end;
		min-height: max(30rem, 78svh);
		overflow: hidden;
		background-color: var(--azul-profundo);
		isolation: isolate;
	}

	.pc-banda__foto {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 90% 55%;
	}

	/* Oscuro abajo (donde va el texto) y arriba (menú); el resto de la foto, limpio. */
	.pc-banda::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(180deg, rgb(18 57 79 / 0.55) 0%, rgb(18 57 79 / 0) 22%),
			linear-gradient(0deg, rgb(18 57 79 / 0.92) 0%, rgb(18 57 79 / 0.6) 32%, rgb(18 57 79 / 0) 62%);
	}

	.pc-banda--sin-foto {
		min-height: 26rem;
	}

	.pc-banda__texto {
		display: grid;
		justify-items: start;
		gap: 1rem;
		padding-block: 8rem 3rem;
	}

	.pc-banda__titulo {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3.25rem, 2rem + 5vw, 6.5rem);
		line-height: 0.95;
		color: var(--blanco-calido);
	}

	.pc-banda__bajada {
		max-width: 30rem;
		font-family: var(--font-body);
		font-size: clamp(1.0625rem, 0.3vw + 1rem, 1.2rem);
		line-height: 1.65;
		color: color-mix(in srgb, var(--blanco-calido) 90%, transparent);
	}

	/* ——— 2. Cuerpo ——— */
	.pc-cuerpo {
		padding-bottom: clamp(4rem, 8vw, 6.5rem);
		background-color: var(--marfil);
		background-image: var(--textura-pigmento);
		background-size: 720px 720px;
		background-blend-mode: soft-light;
	}

	.pc-cuerpo__grilla {
		display: grid;
		gap: 3rem;
	}

	/* Tarjeta del formulario, que se sube sobre la foto. */
	.pc-form {
		position: relative;
		margin-top: -2rem;
		padding: 2rem 1.25rem;
		background-color: var(--blanco-calido);
		box-shadow: 0 34px 70px -40px rgb(18 57 79 / 0.5);
	}

	.pc-form__titulo {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem);
		line-height: 1.05;
		color: var(--azul-profundo);
	}

	.pc-form__nota {
		margin: 0.6rem 0 1.75rem;
		font-family: var(--font-body);
		font-size: 0.975rem;
		color: color-mix(in srgb, var(--tinta) 65%, transparent);
	}

	/* Campos livianos: solo una línea abajo. */
	.pc-form :global(.campo label) {
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		color: color-mix(in srgb, var(--tinta) 70%, transparent);
	}

	.pc-form :global(.campo input),
	.pc-form :global(.campo textarea) {
		padding: 0.7rem 0.1rem;
		border: 0;
		border-bottom: 1px solid #cfc2b4;
		background-color: transparent;
		font-size: 1rem;
		transition: border-color 0.3s var(--ease);
	}

	.pc-form :global(.campo input:focus),
	.pc-form :global(.campo textarea:focus) {
		border-bottom-color: var(--azul-profundo);
		box-shadow: 0 1px 0 0 var(--azul-profundo);
	}

	.pc-form :global(.campo textarea) {
		min-height: 8rem;
	}

	/* Columna de información */
	.pc-info {
		display: grid;
		gap: 2.75rem;
		align-content: start;
	}

	.pc-directo,
	.pc-motivos {
		display: grid;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid color-mix(in srgb, var(--tinta) 14%, transparent);
	}

	.pc-directo li {
		display: grid;
		gap: 0.25rem;
		padding-block: 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--tinta) 14%, transparent);
	}

	.pc-directo__etiqueta {
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--tinta) 55%, transparent);
	}

	.pc-directo a,
	.pc-directo__valor {
		width: fit-content;
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
		line-height: 1.2;
		color: var(--tinta);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.pc-directo a {
		background-image: linear-gradient(var(--dorado), var(--dorado));
		background-size: 0 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition:
			background-size 0.4s var(--ease),
			color 0.3s var(--ease);
	}

	.pc-directo a:hover,
	.pc-directo a:focus-visible {
		background-size: 100% 1px;
		color: var(--azul-medio);
	}

	.pc-motivos li {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: 0.5rem;
		padding-block: 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--tinta) 14%, transparent);
	}

	.pc-motivos__numero {
		padding-top: 0.25rem;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--dorado-oscuro);
	}

	.pc-motivos__titulo {
		display: block;
		font-family: var(--font-display);
		font-size: 1.3rem;
		line-height: 1.2;
		color: var(--tinta);
	}

	.pc-motivos__texto {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--tinta) 70%, transparent);
	}

	@media (min-width: 48rem) {
		.pc-form {
			padding: 2.75rem;
		}
	}

	/* ——— Escritorio ——— */
	@media (min-width: 64rem) {
		.pc-banda {
			align-items: center;
			min-height: max(34rem, 82svh);
		}

		.pc-banda__foto {
			object-position: 60% 58%;
		}

		/* En compu el oscuro va a la izquierda, detrás del texto. */
		.pc-banda::after {
			background:
				linear-gradient(180deg, rgb(18 57 79 / 0.5) 0%, rgb(18 57 79 / 0) 20%),
				linear-gradient(90deg, rgb(18 57 79 / 0.88) 0%, rgb(18 57 79 / 0.6) 30%, rgb(18 57 79 / 0) 58%);
		}

		.pc-banda__texto {
			padding-block: 9rem 11rem;
		}

		.pc-cuerpo__grilla {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			align-items: start;
			gap: clamp(3rem, 7vw, 7rem);
		}

		/* Info a la izquierda, formulario a la derecha subido sobre la foto. */
		.pc-info {
			grid-column: 1;
			grid-row: 1;
			padding-top: 4rem;
		}

		.pc-form {
			grid-column: 2;
			grid-row: 1;
			margin-top: -8rem;
		}
	}
</style>
