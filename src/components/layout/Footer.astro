---
import Firma from './Firma.astro'
import { rutas } from '../../lib/rutas.js'

const { nombre = '', email = '', instagram = '', vimeo = '', youtube = '', creditos = '' } = Astro.props

const redes = [
	{ href: instagram, label: 'Instagram', icono: 'instagram' },
	{ href: vimeo, label: 'Vimeo', icono: 'vimeo' },
	{ href: youtube, label: 'YouTube', icono: 'youtube' },
].filter((item) => item.href)

const paginas = [
	{ href: rutas.inicio, label: 'Inicio' },
	{ href: rutas.cuadros, label: 'Cuadros' },
	{ href: rutas.ilustraciones, label: 'Ilustraciones' },
	{ href: rutas.audiovisual, label: 'Audiovisual' },
	{ href: rutas.sobreMi, label: 'Sobre mí' },
	{ href: rutas.contacto, label: 'Contacto' },
]

const anio = new Date().getFullYear()
const firmante = nombre || 'Celia Gómez Perea'
---

<footer class="site-footer ctx-azul ctx-azul--profundo textura">
	<div class="site-footer__inner contenedor">
		<div class="site-footer__principal">
			{/* Marca */}
			<div class="site-footer__marca-bloque">
				<a class="site-footer__marca" href="/" aria-label={`${firmante}, inicio`}>
					<Firma />
				</a>
				<p class="site-footer__bajada">Artista visual · Patagonia argentina</p>
			</div>

			{/* Navegación */}
			<nav class="site-footer__columna" aria-label="Pie">
				<p class="site-footer__titulo">Recorrer</p>
				<ul class="site-footer__nav">
					{paginas.map((pagina) => (
						<li>
							<a href={pagina.href}>{pagina.label}</a>
						</li>
					))}
				</ul>
			</nav>

			{/* Contacto y redes */}
			<div class="site-footer__columna">
				<p class="site-footer__titulo">Contacto</p>
				{email && (
					<a class="site-footer__dato site-footer__email" href={`mailto:${email}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<rect x="3" y="5.5" width="18" height="13" rx="0.5" />
							<path d="m3.5 6 8.5 7 8.5-7" />
						</svg>
						{email}
					</a>
				)}
				{redes.length > 0 && (
					<ul class="site-footer__redes">
						{redes.map((item) => (
							<li>
								<a class="site-footer__red" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label} (se abre en otra pestaña)`}>
									{item.icono === 'instagram' ? (
										<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
											<rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
											<circle cx="12" cy="12" r="4" />
											<circle cx="17.2" cy="6.8" r="0.6" />
										</svg>
									) : item.icono === 'youtube' ? (
										<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
											<rect x="3" y="6" width="18" height="12" rx="2" />
											<path d="m10 9 6 3-6 3z" />
										</svg>
									) : (
										<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
											<path d="M3 8.6c.9-.7 1.7-1.3 2.4-1.8 1.4-1 2.5-1.2 3.2-.3.8 1 .9 2.9 1.5 5.3.5 2 .9 3 1.5 3 .5 0 1.4-1.1 2.6-3.2 1.1-2 .4-3.1-1-2.5.6-2.9 4.2-4 5.8-2.9 1.5 1.1 1.3 3.9-1.2 7.8-2.4 3.8-4.4 5.7-6 5.7-1.4 0-2.3-1.6-3-4.4-.7-2.6-1.1-5.2-2-5.2-.3 0-1 .4-2.2 1.3" />
										</svg>
									)}
									<span class="site-footer__red-nombre">{item.label}</span>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</div>

		{/* Cierre: copyright y dominio */}
		<div class="site-footer__cierre">
			<p class="site-footer__copia">© {anio} {firmante}</p>
			{creditos && <p class="site-footer__creditos">{creditos}</p>}
			<p class="site-footer__dominio">celiagomezperea.com</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 0;
		padding-block: 3.5rem 2rem;
	}

	.site-footer__principal {
		display: grid;
		gap: 2.5rem;
	}

	.site-footer__marca {
		display: block;
		width: 7rem;
		color: var(--blanco-calido);
	}

	.site-footer__bajada {
		margin-top: 1rem;
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--dorado);
	}

	.site-footer__titulo {
		margin-bottom: 1rem;
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	/* Navegación en dos columnas. */
	.site-footer__nav {
		display: grid;
		grid-template-columns: repeat(2, max-content);
		gap: 0.75rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__nav a {
		color: var(--blanco-calido);
		font-family: var(--font-body);
		font-size: 0.975rem;
		text-decoration: none;
		transition: color 0.3s var(--ease);
	}

	.site-footer__nav a:hover,
	.site-footer__nav a:focus-visible {
		color: var(--dorado);
	}

	.site-footer__dato,
	.site-footer__red {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.75rem;
		color: var(--blanco-calido);
		font-size: 0.975rem;
		text-decoration: none;
		overflow-wrap: anywhere;
		transition: color 0.3s var(--ease);
	}

	.site-footer svg {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.site-footer__email svg {
		color: var(--dorado);
	}

	.site-footer__redes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.75rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__red svg {
		color: var(--dorado);
	}

	.site-footer__red:hover,
	.site-footer__dato:hover {
		color: var(--dorado);
	}

	/* Cierre: línea fina, copyright a la izquierda y dominio a la derecha. */
	.site-footer__cierre {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(212 161 78 / 0.3);
	}

	.site-footer__copia,
	.site-footer__creditos {
		color: var(--azul-bruma);
		font-size: 0.8125rem;
	}

	.site-footer__dominio {
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	.site-footer__marca:focus-visible,
	.site-footer__dato:focus-visible,
	.site-footer__red:focus-visible,
	.site-footer__nav a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 4px;
	}

	/* Tablet: marca arriba a todo el ancho, navegación y contacto en dos columnas. */
	@media (min-width: 40rem) {
		.site-footer__principal {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.site-footer__marca-bloque {
			grid-column: 1 / -1;
		}
	}

	/* Escritorio: tres columnas (marca, navegación, contacto). */
	@media (min-width: 64rem) {
		.site-footer {
			padding-block: 4.5rem 2.25rem;
		}

		.site-footer__principal {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
			gap: 3rem;
		}

		.site-footer__marca-bloque {
			grid-column: auto;
		}

		.site-footer__marca {
			width: 8rem;
		}

		.site-footer__cierre {
			margin-top: 3.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__red,
		.site-footer__dato,
		.site-footer__nav a {
			transition: none;
		}
	}
</style>
