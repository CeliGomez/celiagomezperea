---
import Layout from '../../layouts/Layout.astro'
import Visor from '../../components/obras/Visor.jsx'
import FichaObra from '../../components/obras/FichaObra.astro'
import MasObras from '../../components/obras/MasObras.astro'
import Disciplina from '../../components/obras/Disciplina.astro'
import { fetchDisciplina, fetchDisciplinas, fetchPaginasObra } from '../../lib/sanity.js'
import { rutas } from '../../lib/rutas.js'
import { describirPieza } from '../../lib/piezas.js'

export async function getStaticPaths() {
	const obras = await fetchPaginasObra()
	const slugsObra = new Set(obras.map((pagina) => pagina.params.slug))
	const disciplinas = await fetchDisciplinas()
	for (const disciplina of disciplinas) {
		if (disciplina.slug && slugsObra.has(disciplina.slug)) {
			console.warn(
				`[rutas] El slug "${disciplina.slug}" ya pertenece a una obra. Se publica la ficha y no la página de la disciplina.`,
			)
		}
	}
	const paginasDisciplina = disciplinas
		// Solo Ilustraciones tiene página propia: los cuadros se recorren en /series.
		.filter((disciplina) => disciplina.slug === 'obras-sobre-papel' && !slugsObra.has(disciplina.slug))
		.map((disciplina) => ({
			params: { slug: disciplina.slug },
			props: { tipo: 'disciplina', slug: disciplina.slug },
		}))
	return [
		...obras.map((pagina) => ({
			...pagina,
			props: { ...pagina.props, tipo: 'obra' },
		})),
		...paginasDisciplina,
	]
}

const esDisciplina = Astro.props.tipo === 'disciplina'
const paginaDisciplina = esDisciplina ? await fetchDisciplina(Astro.props.slug) : null
const ficha = esDisciplina ? null : Astro.props
const artista = esDisciplina ? paginaDisciplina?.artista : ficha?.artista
const configuracion = esDisciplina ? paginaDisciplina?.configuracion : ficha?.configuracion
const titulo = esDisciplina
	? artista?.nombre
		? `${paginaDisciplina.disciplina.nombre} — ${artista.nombre}`
		: paginaDisciplina?.disciplina?.nombre || 'Disciplina'
	: [
			ficha.enSerie?.serie?.nombre
				? `${ficha.obra.titulo === 'Sin título' ? '' : ficha.obra.titulo + ' · '}${ficha.enSerie.serie.nombre} N.º ${ficha.obra.numero}`
				: ficha.obra.titulo,
			artista?.nombre,
		]
			.filter(Boolean)
			.join(' — ')
// «Cuadro N.º 3 de la obra «Una vez vi blanco», de Celia Gómez Perea. Código VVB-03.»
const pieza = esDisciplina
	? ''
	: describirPieza({
			titulo: ficha.obra.titulo,
			obra: ficha.enSerie?.serie?.nombre || '',
			numero: ficha.obra.numero,
			ilustracion: ficha.obra.ilustracion,
		})
const descripcion = esDisciplina
	? paginaDisciplina?.disciplina?.descripcion || titulo
	: ficha.obra.descripcionCorta ||
		[
			artista?.nombre ? `${pieza}, de ${artista.nombre}.` : `${pieza}.`,
			ficha.obra.codigo ? `Código ${ficha.obra.codigo}.` : '',
		]
			.filter(Boolean)
			.join(' ')
// Miga de la pieza: vuelve a Cuadros o a Ilustraciones, y a su obra.
const volver = ficha?.obra?.ilustracion
	? { href: rutas.ilustraciones, texto: 'Ilustraciones' }
	: { href: rutas.cuadros, texto: 'Cuadros' }
const datos = !esDisciplina && ficha?.obra?.titulo
	? {
			'@context': 'https://schema.org',
			'@type': 'VisualArtwork',
			name: ficha.obra.titulo === 'Sin título' ? pieza : ficha.obra.titulo,
			...(artista?.nombre ? { creator: { '@type': 'Person', name: artista.nombre } } : {}),
			...(ficha.obra.imagenes?.[0]?.src ? { image: new URL(ficha.obra.imagenes[0].src, Astro.site ?? Astro.url).href } : {}),
			...(ficha.obra.anio ? { dateCreated: String(ficha.obra.anio) } : {}),
			...(ficha.obra.tecnica ? { artMedium: ficha.obra.tecnica } : {}),
			url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
		}
	: null
---

{
	esDisciplina && paginaDisciplina ? (
		<Layout
			title={titulo}
			description={descripcion}
			nombre={artista?.nombre}
			subtitulo={artista?.subtitulo}
			email={configuracion?.email}
			ciudad={configuracion?.ciudad}
			instagram={configuracion?.instagram}
			vimeo={configuracion?.vimeo}
			youtube={configuracion?.youtube}
			heroAzul
		>
			<Disciplina disciplina={paginaDisciplina.disciplina} series={paginaDisciplina.series} obras={paginaDisciplina.obras} />
		</Layout>
	) : ficha?.obra ? (
		<Layout
			title={titulo}
			description={descripcion}
			ogImage={ficha.obra.imagenes?.[0]?.src}
			ogImageAlt={ficha.obra.imagenes?.[0]?.alt || ficha.obra.titulo}
			nombre={artista?.nombre}
			subtitulo={artista?.subtitulo}
			email={configuracion?.email}
			ciudad={configuracion?.ciudad}
			instagram={configuracion?.instagram}
			vimeo={configuracion?.vimeo}
			youtube={configuracion?.youtube}
			datos={datos}
			seccion={ficha.obra.ilustracion ? 'ilustraciones' : 'cuadros'}
			heroAzul
		>
			<div class="pieza-pagina">
				{/* Sala azul: la pieza «colgada» sobre la pared azul y su ficha al lado. */}
				<section class="pieza-sala ctx-azul ctx-azul--profundo textura">
				{/* Miga: sección › obra */}
				<nav class="pieza-miga contenedor" aria-label="Ubicación">
					<a href={volver.href}>{volver.texto}</a>
					{ficha.enSerie?.serie?.href && (
						<>
							<span aria-hidden="true">/</span>
							<a href={ficha.enSerie.serie.href}>{ficha.enSerie.serie.nombre}</a>
						</>
					)}
				</nav>

				<article class="pieza contenedor">
					<div class="pieza__visor">
						<Visor
							client:load
							imagenes={ficha.obra.imagenes}
							titulo={
								ficha.obra.titulo === 'Sin título' && ficha.enSerie?.serie?.nombre
									? `${ficha.enSerie.serie.nombre} · N.º ${ficha.obra.numero}`
									: ficha.obra.titulo
							}
							anio={ficha.obra.anio}
							slug={ficha.obra.slug}
							relacion={ficha.obra.relacion}
						/>
						<p class="pieza__ayuda">Tocá la imagen para verla en grande.</p>
					</div>
					<FichaObra
						oscura
						obra={ficha.obra}
						whatsapp={configuracion?.whatsapp}
						envio={configuracion?.envioColeccion || ''}
						anterior={ficha.enSerie ? ficha.enSerie.anterior : null}
						siguiente={ficha.enSerie ? ficha.enSerie.siguiente : null}
						enSerie={ficha.enSerie}
						url={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
					/>
				</article>
				</section>

				<MasObras obras={ficha.relacionadas} serie={ficha.enSerie?.serie || null} ilustracion={ficha.obra.ilustracion} />
			</div>
		</Layout>
	) : null
}

<style>
	/* ——— Página de una pieza ——— */
	.pieza-sala {
		padding-top: 7rem;
	}

	.pieza-miga {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	.pieza-miga a {
		color: var(--blanco-calido);
		text-decoration: none;
	}

	.pieza-miga a:hover,
	.pieza-miga a:focus-visible {
		color: var(--dorado);
	}

	.pieza {
		display: grid;
		gap: 2.5rem;
		padding-bottom: clamp(3.5rem, 7vw, 6rem);
	}

	/* La pieza sobre la pared azul, con una sombra profunda. */
	.pieza__visor :global(.visor__escena) {
		min-height: clamp(18rem, 55vh, 42rem);
		padding: 0;
		background: transparent;
	}

	.pieza__visor :global(.visor__img) {
		max-height: 74svh;
		filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.5));
	}

	.pieza__visor :global(.visor__mini) {
		outline-color: var(--dorado);
	}

	.pieza__ayuda {
		margin-top: 1rem;
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	@media (min-width: 64rem) {
		.pieza-sala {
			padding-top: 8.5rem;
		}

		.pieza {
			grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
			align-items: start;
			gap: clamp(3rem, 5vw, 5rem);
		}

		.pieza__visor {
			position: sticky;
			top: 6.5rem;
		}
	}
</style>
