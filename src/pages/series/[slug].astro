---
import Layout from '../../layouts/Layout.astro'
import Imagen from '../../components/home/Imagen.astro'
import PiezasDeObra from '../../components/series/PiezasDeObra.astro'
import { fetchInicio, fetchSerie, fetchSeries } from '../../lib/sanity.js'
import { rutas } from '../../lib/rutas.js'

export async function getStaticPaths() {
	const series = await fetchSeries()
	return series.filter((serie) => serie.slug).map((serie) => ({ params: { slug: serie.slug } }))
}

const serie = await fetchSerie(Astro.params.slug)
const { artista, configuracion } = await fetchInicio()
const nombre = artista?.nombre || ''
const titulo = serie ? (nombre ? `${serie.nombre} — ${nombre}` : serie.nombre) : 'Serie'
// Las obras de ilustración vuelven a Ilustraciones; las de cuadros, a Cuadros.
const esIlustracion = serie?.disciplina?.slug === 'obras-sobre-papel'
const seccion = esIlustracion
	? { href: rutas.ilustraciones, nombre: 'Ilustraciones', todas: 'Ver todas las obras de ilustraciones' }
	: { href: rutas.cuadros, nombre: 'Cuadros', todas: 'Ver todas las obras de cuadros' }
const cantidad = serie?.obras?.length || 0
const unidad = esIlustracion ? (cantidad === 1 ? 'ilustración' : 'ilustraciones') : cantidad === 1 ? 'cuadro' : 'cuadros'
const meta = [cantidad ? `${cantidad} ${unidad}` : '', serie?.anio, serie?.tecnicaGeneral].filter(Boolean)
// Sin texto cargado: «Una vez vi blanco, obra de Celia Gómez Perea: 9 cuadros.»
const descripcion =
	serie?.descripcion ||
	(serie ? `${serie.nombre}, obra de ${nombre || 'la artista'}${cantidad ? `: ${cantidad} ${unidad}` : ''}.` : 'Serie')
---

{
	serie && (
		<Layout
			title={titulo}
			description={descripcion}
			seccion={esIlustracion ? 'ilustraciones' : 'cuadros'}
			nombre={artista?.nombre}
			subtitulo={artista?.subtitulo}
			email={configuracion?.email}
			ciudad={configuracion?.ciudad}
			instagram={configuracion?.instagram}
			vimeo={configuracion?.vimeo}
			youtube={configuracion?.youtube}
			heroAzul
		>
			{/* ——— Banda azul: nombre de la obra y su portada ——— */}
			<header class="presentacion ctx-azul ctx-azul--profundo textura">
				<div class="presentacion__inner contenedor">
					<div class="presentacion__texto">
						<a class="presentacion__miga" href={seccion.href}>
							<span aria-hidden="true">←</span>
							{seccion.nombre}
						</a>
						<p class="presentacion__etiqueta">Obra · serie de {esIlustracion ? 'ilustraciones' : 'cuadros'}</p>
						<h1 class="presentacion__titulo">{serie.nombre}</h1>
						<span class="filete filete--largo" aria-hidden="true" />
						{meta.length > 0 && <p class="presentacion__meta">{meta.join(' · ')}</p>}
						<div class="presentacion__acciones">
							{cantidad > 0 && (
								<a class="btn presentacion__btn presentacion__btn--relleno" href="#piezas">
									Ver {esIlustracion ? 'las ilustraciones' : 'los cuadros'}
									<span aria-hidden="true">↓</span>
								</a>
							)}
							{serie.descripcionHtml && (
								<a class="btn presentacion__btn presentacion__btn--contorno" href="#texto">
									Leer el texto de la obra
								</a>
							)}
						</div>
					</div>
					<div class="presentacion__portada">
						<Imagen
							source={serie.portada}
							alt={serie.portada?.alt || serie.nombre}
							width={1000}
							marco="portada"
							proporcion="vertical"
							priority
							sizes="(min-width: 64rem) 30rem, 90vw"
						/>
					</div>
				</div>
			</header>

			{/* ——— Texto de la obra, como el texto de sala de una muestra ——— */}
			{
				serie.descripcionHtml && (
					<section id="texto" class="texto-obra" aria-labelledby="texto-obra-titulo">
						<div class="texto-obra__inner contenedor">
							<div class="texto-obra__encabezado">
								<h2 id="texto-obra-titulo" class="t-seccion">Texto de la obra</h2>
								<span class="filete filete--largo" aria-hidden="true" />
							</div>
							<div class="texto-obra__columna">
								<div class="texto-obra__cuerpo" data-texto-obra set:html={serie.descripcionHtml} />
								<button type="button" class="texto-obra__mas" data-texto-mas hidden>
									Leer todo el texto
								</button>
							</div>
						</div>
					</section>
				)
			}

			<script>
				// Textos largos: se muestran los primeros párrafos y un botón para leer todo.
				const iniciarTexto = () => {
					const cuerpo = document.querySelector('[data-texto-obra]')
					const boton = document.querySelector('[data-texto-mas]')
					if (!cuerpo || !boton || cuerpo.dataset.listo) return
					cuerpo.dataset.listo = 'true'
					if (cuerpo.querySelectorAll('p').length <= 4) return
					cuerpo.classList.add('is-corto')
					boton.hidden = false
					boton.addEventListener('click', () => {
						cuerpo.classList.remove('is-corto')
						boton.hidden = true
					})
				}
				iniciarTexto()
				document.addEventListener('astro:page-load', iniciarTexto)
			</script>

			{/* ——— Las piezas ——— */}
			<section id="piezas" class="piezas-obra" aria-labelledby="piezas-titulo">
				<div class="contenedor">
					<div class="piezas-obra__encabezado">
						<h2 id="piezas-titulo" class="piezas-obra__titulo">
							{esIlustracion ? 'Las ilustraciones' : 'Los cuadros'}
						</h2>
						{cantidad > 0 && <p class="piezas-obra__cantidad">{cantidad} {unidad} · tocá uno para verlo en grande</p>}
					</div>
					{cantidad > 0 ? (
						<PiezasDeObra obras={serie.obras} papel={esIlustracion} />
					) : (
						<p class="t-texto piezas-obra__vacio">Todavía no hay piezas publicadas en esta obra.</p>
					)}
				</div>
			</section>

			{/* ——— Seguir recorriendo ——— */}
			<nav class="recorrido" aria-label="Otras obras">
				<div class="contenedor">
					{(serie.anterior || serie.siguiente) && (
						<div class="recorrido__vecinas">
							{serie.anterior ? (
								<a class="recorrido__vecina" href={serie.anterior.href}>
									{serie.anterior.portada && (
										<span class="recorrido__miniatura">
											<Imagen source={serie.anterior.portada} alt="" width={240} height={240} marco="portada" proporcion="cuadrada" sizes="7rem" />
										</span>
									)}
									<span class="recorrido__texto">
										<span class="recorrido__etiqueta">← Obra anterior</span>
										<span class="recorrido__nombre">{serie.anterior.nombre}</span>
									</span>
								</a>
							) : (
								<span />
							)}
							{serie.siguiente && (
								<a class="recorrido__vecina recorrido__vecina--siguiente" href={serie.siguiente.href}>
									<span class="recorrido__texto">
										<span class="recorrido__etiqueta">Obra siguiente →</span>
										<span class="recorrido__nombre">{serie.siguiente.nombre}</span>
									</span>
									{serie.siguiente.portada && (
										<span class="recorrido__miniatura">
											<Imagen source={serie.siguiente.portada} alt="" width={240} height={240} marco="portada" proporcion="cuadrada" sizes="7rem" />
										</span>
									)}
								</a>
							)}
						</div>
					)}
					<p class="recorrido__todas">
						<a class="btn btn-contorno" href={seccion.href}>
							{seccion.todas}
						</a>
					</p>
				</div>
			</nav>
		</Layout>
	)
}

<style>
	/* ——— Banda azul ——— */
	.presentacion {
		padding-top: 6.5rem;
		padding-bottom: clamp(3rem, 6vw, 4.5rem);
	}

	.presentacion__inner {
		display: grid;
		gap: 2.5rem;
	}

	.presentacion__texto {
		display: grid;
		justify-items: start;
		align-content: center;
		gap: 1rem;
	}

	.presentacion__miga {
		display: inline-flex;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--azul-bruma);
		text-decoration: none;
		transition: color 0.3s var(--ease);
	}

	.presentacion__miga:hover,
	.presentacion__miga:focus-visible {
		color: var(--dorado);
	}

	.presentacion__etiqueta {
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--dorado);
	}

	.presentacion__titulo {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.75rem, 1.6rem + 4.5vw, 5.5rem);
		line-height: 0.98;
		color: var(--blanco-calido);
		text-wrap: balance;
	}

	.presentacion__meta {
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--azul-bruma);
	}

	.presentacion__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 1rem;
	}

	.presentacion__btn {
		min-height: 3rem;
		padding-inline: 1.5rem;
	}

	.presentacion__btn--relleno {
		border-color: var(--blanco-calido);
		background-color: var(--blanco-calido);
		color: var(--azul-profundo);
	}

	.presentacion__btn--relleno:hover,
	.presentacion__btn--relleno:focus-visible {
		border-color: var(--marfil);
		background-color: var(--marfil);
	}

	.presentacion__btn--contorno {
		border-color: color-mix(in srgb, var(--blanco-calido) 60%, transparent);
		color: var(--blanco-calido);
	}

	.presentacion__btn--contorno:hover,
	.presentacion__btn--contorno:focus-visible {
		border-color: var(--dorado);
		color: var(--dorado);
	}

	.presentacion__portada {
		width: min(100%, 24rem);
	}

	.presentacion__portada :global(.marco) {
		width: 100%;
		box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
	}

	/* ——— Texto de la obra ——— */
	.texto-obra {
		padding-block: clamp(3.5rem, 7vw, 6rem);
		background-color: var(--marfil);
		scroll-margin-top: 4rem;
	}

	.texto-obra__inner {
		display: grid;
		gap: 2rem;
	}

	.texto-obra__cuerpo {
		max-width: 40rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.55rem);
		line-height: 1.55;
		color: var(--tinta);
	}

	.texto-obra__cuerpo :global(p + p) {
		margin-top: 0.9em;
	}

	/* Recortado: se ven unos 4 párrafos y el resto se desvanece. */
	.texto-obra__cuerpo:global(.is-corto) {
		max-height: 17em;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, black 60%, transparent 100%);
		mask-image: linear-gradient(180deg, black 60%, transparent 100%);
	}

	.texto-obra__mas {
		margin-top: 1.25rem;
		padding: 0 0 0.25rem;
		border: 0;
		border-bottom: 1px solid var(--dorado);
		background: none;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--azul-profundo);
		cursor: pointer;
	}

	.texto-obra__mas:hover,
	.texto-obra__mas:focus-visible {
		color: var(--dorado-oscuro);
	}

	/* La primera línea, un poco más grande y en cursiva, como entrada. */
	.texto-obra__cuerpo :global(p:first-child) {
		font-style: italic;
		font-size: 1.2em;
		line-height: 1.35;
		color: var(--azul-profundo);
	}

	/* ——— Piezas ——— */
	.piezas-obra {
		padding-block: clamp(3.5rem, 7vw, 6rem);
		scroll-margin-top: 4rem;
	}

	.piezas-obra__encabezado {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.piezas-obra__titulo {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem);
		line-height: 1;
	}

	.piezas-obra__cantidad {
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--tinta) 60%, transparent);
	}

	.piezas-obra__vacio {
		max-width: 34rem;
		color: var(--gris);
	}

	/* ——— Recorrido: obra anterior / siguiente ——— */
	.recorrido {
		padding-block: clamp(3rem, 6vw, 4.5rem);
		background-color: var(--marfil);
	}

	.recorrido__vecinas {
		display: grid;
		gap: 1rem;
	}

	.recorrido__vecina {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1rem;
		background-color: var(--blanco-calido);
		color: var(--tinta);
		text-decoration: none;
		transition: box-shadow 0.3s var(--ease);
	}

	.recorrido__vecina:hover,
	.recorrido__vecina:focus-visible {
		box-shadow: 0 20px 40px -28px rgb(18 57 79 / 0.45);
	}

	.recorrido__miniatura {
		flex: none;
		width: 5.5rem;
	}

	.recorrido__miniatura :global(.marco) {
		width: 100%;
	}

	.recorrido__texto {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.recorrido__etiqueta {
		font-family: var(--font-ui);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--dorado-oscuro);
	}

	.recorrido__nombre {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
		line-height: 1.15;
	}

	.recorrido__todas {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
	}

	.recorrido a:focus-visible {
		outline: 1px solid var(--azul-medio);
		outline-offset: 4px;
	}

	@media (min-width: 48rem) {
		.recorrido__vecinas {
			grid-template-columns: 1fr 1fr;
		}

		.recorrido__vecina--siguiente {
			justify-content: flex-end;
			text-align: right;
		}
	}

	@media (min-width: 64rem) {
		.presentacion {
			padding-top: 8.5rem;
		}

		.presentacion__inner {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: center;
			gap: clamp(3rem, 6vw, 6rem);
		}

		.presentacion__portada {
			width: min(100%, 28rem);
			justify-self: end;
		}

		.texto-obra__inner {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			align-items: start;
		}
	}

	@media (max-width: 47.99rem) {
		.presentacion__acciones {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
